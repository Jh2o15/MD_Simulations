@topo    peptide.top
# We use a cubic box (r = rectangular)
@pbc     r
# coordinates of the solute.
@pos  peptide_fixed_h.cnf
# coordinates of the box containing SPC water molecules.
@solvent spc.cnf
# the minimum solute-wall distance
@minwall 0.8
# the minimum solute-solvent distance
@thresh  0.23
# used if one uses trucated octahedron pbc
@rotate
