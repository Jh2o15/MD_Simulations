# this combines several topologies into one solute topology.
@topo  peptide.top 2:Cl_54a7.top
# the parameters (what you specified with @param in maketop) are taken from the first topology. 
# this is not so important because all our topologies use the same force field anyway.
@param 1
# the solvent is taken from the first topology.
@solv  1

